{
  "name": "local-project-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "Windows local project launcher for managing ports, project startup, and local paths.",
  "main": "dist-electron/main/main.js",
  "type": "module",
  "scripts": {
    "dev:safe": "node scripts/dev-safe.cjs",
    "dev": "vite --host 0.0.0.0 --strictPort",
    "dev:electron": "npm run build:electron && cross-env NODE_ENV=development electron .",
    "build": "tsc && vite build && npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "preview": "vite preview --host 127.0.0.1",
    "start": "cross-env NODE_ENV=production electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "cross-env": "^7.0.3",
    "electron-is-dev": "^3.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^42.5.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^8.1.0"
  },
  "build": {
    "appId": "com.localproject.launcher",
    "productName": "Local Project Launcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "preload.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
